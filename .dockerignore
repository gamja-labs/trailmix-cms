# Dependency directory
**/node_modules/

# Yarn
.pnp.*

# Build output
**/dist/
**/tsconfig.tsbuildinfo

.env*
# `.env*` alone only matches the repo root — Docker patterns are not recursive. Without
# this, examples/*/.env (real credentials) is copied into every image by `COPY . .`.
**/.env*
!**/.env.example

# e2e artifacts — never part of an app image
test/e2e/report/
test/e2e/test-results/

# Yarn's local caches are ~850MB across the root, docs/ and iac/ projects, and are
# regenerated by `yarn install` inside the image — shipping them just slows every build,
# and copying the host's install state over the container's invites hard-to-read
# resolution failures. `**/` is required: docs/.yarn and iac/.yarn are nested.
**/.yarn/cache
**/.yarn/unplugged
**/.yarn/install-state.gz
**/.yarn/sdks

# History is never needed to build an image.
.git

# Generated, git-ignored artifacts. The e2e image regenerates both in Dockerfile's `spa` stage
# before it builds the SPA, so a host copy only busts the `COPY . .` cache layer — and a stale
# local client would mask exactly the core-api/core-web drift that regenerating exists to catch.
# (`writeOpenApiSpec` mkdir -p's the docs directory, so excluding it wholesale is safe.)
examples/core-api/docs/
examples/core-web/src/client/Api.ts
